---
import '../styles/global.css';
const { title='TheWorthScout | Independent Guides & Product Reviews', description='Independent buying guides and product reviews to help you make more informed choices.', robots='index,follow' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="robots" content={robots}/><link rel="canonical" href={new URL(Astro.url.pathname, 'https://theworthscout.com').toString()}/><title>{title}</title></head><body><header><div class="wrap nav"><a class="logo" href="/">theworth<span>scout</span></a><nav aria-label="Main navigation"><a href="/pets/">Pets</a><a href="/about/">About</a><a href="/editorial-policy/">Our Standards</a><a href="/contact/">Contact</a></nav></div></header><main><slot/></main><footer><div class="wrap foot"><div>© {new Date().getFullYear()} TheWorthScout<br/>Independent Guides & Product Reviews</div><div class="footlinks"><a href="/affiliate-disclosure/">Affiliate Disclosure</a><a href="/privacy-policy/">Privacy</a><a href="/editorial-policy/">Editorial Policy</a><a href="/contact/">Contact</a></div></div></footer></body></html>
