---
import '../styles/global.css';
import { locales, shell } from '../i18n/content.js';

const {
  title='TheWorthScout | Independent Guides & Product Reviews',
  description='Independent buying guides and product reviews to help you make more informed choices.',
  robots='index,follow',
  locale='en',
} = Astro.props;

const ui = shell[locale] ?? shell.en;
const localePrefix = locale === 'en' ? '' : `/${locale}`;
const currentPath = Astro.url.pathname;
const basePath = currentPath.replace(/^\/(es-us|pt-br)(?=\/|$)/, '') || '/';
const localizedPath = (targetLocale) => targetLocale === 'en'
  ? basePath
  : `/${targetLocale}${basePath === '/' ? '/' : basePath}`;
const route = (path) => `${localePrefix}${path}`;
const canonicalUrl = new URL(currentPath, 'https://theworthscout.com').toString();
---
<!doctype html>
<html lang={ui.htmlLang}>
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content={description}/>
    <meta name="robots" content={robots}/>
    <link rel="canonical" href={canonicalUrl}/>
    {locales.map((code) => <link rel="alternate" hreflang={shell[code].htmlLang} href={new URL(localizedPath(code), 'https://theworthscout.com').toString()}/>)}
    <link rel="alternate" hreflang="x-default" href={new URL(basePath, 'https://theworthscout.com').toString()}/>
    <title>{title}</title>
  </head>
  <body>
    <header>
      <div class="wrap nav">
        <a class="logo" href={route('/')}>
          theworth<span>scout</span><small>{ui.tagline}</small>
        </a>
        <div class="nav-actions">
          <nav aria-label={ui.navLabel}>
            <a href={route('/pets/')}>{ui.pets}</a>
            <a href={route('/about/')}>{ui.about}</a>
            <a href={route('/editorial-policy/')}>{ui.standards}</a>
            <a href={route('/contact/')}>{ui.contact}</a>
          </nav>
          <nav class="locale-switcher" aria-label={ui.languageLabel}>
            <a href={localizedPath('en')} hreflang="en-US" lang="en" aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
            <a href={localizedPath('es-us')} hreflang="es-US" lang="es" aria-current={locale === 'es-us' ? 'page' : undefined}>ES</a>
            <a href={localizedPath('pt-br')} hreflang="pt-BR" lang="pt" aria-current={locale === 'pt-br' ? 'page' : undefined}>PT</a>
          </nav>
        </div>
      </div>
    </header>
    <main><slot/></main>
    <footer>
      <div class="wrap foot">
        <div>© {new Date().getFullYear()} TheWorthScout<br/>{ui.footer}</div>
        <div class="footlinks">
          <a href={route('/affiliate-disclosure/')}>{ui.affiliate}</a>
          <a href={route('/privacy-policy/')}>{ui.privacy}</a>
          <a href={route('/editorial-policy/')}>{ui.editorial}</a>
          <a href={route('/contact/')}>{ui.contact}</a>
        </div>
      </div>
    </footer>
  </body>
</html>
